# Academic Insight — Environment Configuration Template
# Copy this file to .env.local for Supabase Auth & PostgreSQL RLS connection.
# Note: Only the public anon key is used in the client. NEVER expose a Supabase service_role key in VITE_* variables.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server-side HMAC signing secret for the local Node RBAC backend when running without external Supabase
ACADEMIC_INSIGHT_SESSION_SECRET=
